# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# PostgreSQL from Neon, Supabase, etc.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Brevo (formerly Sendinblue) transactional email
BREVO_API_KEY=xkeysib-...

# Verified sender email in Brevo
MAIL_FROM=noreply@yourdomain.com

# Secret token to protect /send-reminders route
# Generate: python -c "import secrets; print(secrets.token_hex(24))"
REMINDER_TOKEN=your_reminder_token_here
